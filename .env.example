# .env.example
#
# Ce fichier est le MODÈLE de votre configuration. Il ne contient aucun secret
# et il est versionné (contrairement à `.env`, qui est ignoré par Git).
#
# Sur Railway, ces variables se saisissent dans l'onglet « Variables » du
# projet — Railway ne lit pas ce fichier.
#
# En local, copiez-le en `.env` et ajustez les valeurs.

# ---------------------------------------------------------------------------
# OBLIGATOIRE pour que les données survivent aux redéploiements
# ---------------------------------------------------------------------------
# Sans cette variable, la base est créée dans le conteneur, qui est JETABLE :
# toutes vos tâches, preuves et comptes disparaissent à chaque déploiement.
# Elle doit pointer vers le volume persistant monté sur /data.
# Chemin local si vous n'utilisez pas de volume : laissez vide.
DB_PATH=/data/doli.sqlite

# ---------------------------------------------------------------------------
# Premier démarrage : créer un compte
# ---------------------------------------------------------------------------
# Les inscriptions sont FERMÉES par défaut, c'est volontaire : cela empêche
# quelqu'un qui découvre l'adresse du site de créer un compte.
#
# Mettez true pour créer VOTRE premier compte, puis repassez à false et
# redéployez. Ne laissez jamais true en production, sauf si vous avez
# défini REGISTRATION_SECRET ci-dessous.
ALLOW_REGISTRATION=true

# ---------------------------------------------------------------------------
# Code d'invitation (fortement recommandé si les inscriptions sont ouvertes)
# ---------------------------------------------------------------------------
# Tant que cette variable est définie, un code est exigé pour s'inscrire.
# Choisissez une valeur non devinable. Laissez vide pour aucun code.
# REGISTRATION_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# ---------------------------------------------------------------------------
# Facultatif : restreindre les domaines d'inscription
# ---------------------------------------------------------------------------
# Liste séparée par des virgules. Vide = tous les domaines acceptés.
# EMAIL_DOMAIN_ALLOWLIST=gmail.com,orange.fr

# ---------------------------------------------------------------------------
# Sécurité des cookies
# ---------------------------------------------------------------------------
# true dès que le site est servi en HTTPS (le cas sur Railway).
# Laissez false en local : un cookie « secure » reçu en HTTP est REFUSÉ par
# le navigateur, ce qui empêcherait la connexion.
COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Base de données : mode de journalisation
# ---------------------------------------------------------------------------
# Valeurs possibles : WAL (défaut), DELETE, TRUNCATE, PERSIST, MEMORY.
#
# WAL est le plus rapide, mais il s'appuie sur des fonctions de mémoire
# partagée (mmap) qui ne sont PAS fiables sur un système de fichiers réseau —
# un volume Railway en est un. Si la base refuse de s'ouvrir sur Railway
# (« disk I/O error »), mettez DELETE.
# En local, ne changez rien : WAL est le comportement normal.
# DB_JOURNAL_MODE=DELETE
